# Chemin vers la base SQLite (relative au dossier node/)
DATABASE_PATH=../data/es_cache.sqlite

# Profil Steam - NE PAS DEFINIR MANUELLEMENT
# Ce parametre est defini automatiquement apres authentification
# (utilise profiles/<SteamID64> pour eviter les redirections /my/)
# STEAM_PROFILE_PATH=my

# Ce n est PAS le compte scrape (inventory/SCE) : le compte principal est identifie
# par son URL personnalisee (id/xxxxxxx => SteamID64 7890789078907890).
# Surchargeable via la variable d environnement BADGE_PROFILE_PATH.
BADGE_PROFILE_PATH = 

# --- Authentification Steam ---
# Methode d'authentification: auto (menu), password, ou qr
STEAM_AUTH_METHOD=auto

# Cookie Steam - Option 1: defini manuellement (format header complet)
# Exemple: steamLoginSecure=76561198xxxxx%7C%7CeyJhbG...; sessionid=abc123
# Laisser vide pour utiliser l'authentification steam-session (mot de passe/QR)
STEAM_COOKIE=

# Cookie Steam Card Exchange - format header complet
# Exemple: PHPSESSID=abc123def456; cookie_consent=1
# Recuperez-le depuis votre navigateur: DevTools > Application > Cookies > steamcardexchange.net
SCE_COOKIE=

# Limite de concurrence (nombre de requetes paralleles)
CONCURRENCY_LIMIT=4

# Delai anti-rate-limit en ms entre les pages d'inventaire
INVENTORY_PAGE_DELAY=800

# Partenaire et token pour les trade offers
TRADE_PARTNER=83905207
TRADE_TOKEN=tEx7-bXd

# AppIDs des evenements Steam (Sales, Awards, etc.) - separes par des virgules
# Utilises par isSteamEvent() pour classer les badges d'evenements
EVENT_APP_IDS=335590,365960,425280,483980,566020,639900,762800,876740,991980,1096040,1263330,1343890,1493030,1658760,1790600,1926100,2243720,2459330,2640160,2861690,3344600,3558940,866860,1083560,1442870,1195670,1797760

# --- Serveur API REST ---
# Hote et port du serveur API (lecture seule de la DB)
# Le serveur est demarre par `npm run api` ou integre au daemon `npm run sync`
API_HOST=127.0.0.1
API_PORT=3001
